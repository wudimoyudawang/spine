# ── 依赖与构建产物 ──────────────────────────────
node_modules/
dist/
build/
out/
__pycache__/
*.py[cod]
.venv/
venv/
.venv-*/

# ── 数据文件（本地数据库与导出，绝不入库）────────
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
data/
exports/
backup/

# ── 环境变量与密钥（★ 误入库 = 一票否决事故）────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
credentials.*

# ── 编辑器与操作系统 ───────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ── 本机助手工作记忆（含本机路径，不进公开仓库）──
.workbuddy/

# ── 日志与临时文件 ─────────────────────────────
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*
*.tmp
.cache/

# ── 移动端打包产物与签名 ───────────────────────
# 签名文件等同密钥（上面那条一票否决），先拦在这里。
*.apk
*.aab
*.jks
*.keystore

# ── Android 壳（shell/）────────────────────────
# 只留「源码与配置」，其余都是能重建的。
shell/node_modules/
shell/www/
shell/keystore.properties
shell/android/local.properties
shell/android/.gradle/
shell/android/capacitor-cordova-android-plugins/
shell/android/app/src/main/assets/public/
shell/android/app/src/main/assets/capacitor.config.json
shell/android/app/src/main/assets/capacitor.plugins.json

# ── 但要放行打好的安装包（宇要求入库，便于直接从仓库下载）──
# 注：每次重打都会多存一份二进制，仓库会慢慢变大。
# 更新包时把旧的删掉再提交，别让历史里堆一串。
!release/spine.apk
