{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "计划中枢",
  "version": "0.1.0",
  "identifier": "com.spine.planner",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "个人计划中枢",
        "width": 420,
        "height": 880,
        "minWidth": 360,
        "minHeight": 560,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
